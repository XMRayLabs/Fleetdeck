# Public deployment settings only. Master keys live in ./secrets, not here.
DEPLOYMENT_MODE=docker
WEB_PORT=18111
COOKIE_SECURE=true
BATCH_UPLOAD_MAX_MB=200
API_RATE_LIMIT=1200
BCRYPT_ROUNDS=12

# Passkey / WebAuthn origin. Use the final HTTPS hostname.
RP_ID=fleet.example.com
RP_ORIGIN=https://fleet.example.com
APP_ORIGIN=https://fleet.example.com

# Official GitHub repository, used only for manual release checks.
VITE_PROJECT_REPOSITORY_URL=https://github.com/Sakurame1/FleetDeck

REMOTE_GATEWAY_API_BASE_LOCAL=http://localhost:9090
REMOTE_GATEWAY_API_BASE_DOCKER=http://remote-gateway:9090
REMOTE_GATEWAY_WS_URL_LOCAL=ws://localhost:8080
REMOTE_GATEWAY_WS_URL_DOCKER=ws://remote-gateway:8080
